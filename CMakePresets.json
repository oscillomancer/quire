{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++",
                          "SUPPLE_BUILD_TESTS": "ON" }
    },
    { "name": "dev", "inherits": "base", "displayName": "Clang Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SUPPLE_WERROR": "ON" } },
    { "name": "release", "inherits": "base", "displayName": "Clang Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SUPPLE_WERROR": "ON" } },
    { "name": "gcc", "inherits": "base", "displayName": "GCC Debug",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++",
                          "CMAKE_BUILD_TYPE": "Debug", "SUPPLE_WERROR": "ON" } },
    { "name": "asan", "inherits": "base", "displayName": "Clang ASan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SUPPLE_SANITIZE": "address",
                          "SUPPLE_BUILD_GUI": "OFF" } },
    { "name": "ubsan", "inherits": "base", "displayName": "Clang UBSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SUPPLE_SANITIZE": "undefined",
                          "SUPPLE_BUILD_GUI": "OFF" } },
    { "name": "tsan", "inherits": "base", "displayName": "Clang TSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SUPPLE_SANITIZE": "thread",
                          "SUPPLE_BUILD_GUI": "OFF" } },
    { "name": "rtsan", "inherits": "base", "displayName": "Clang RealtimeSanitizer",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SUPPLE_SANITIZE": "realtime",
                          "SUPPLE_BUILD_GUI": "OFF" } },
    {
      "name": "macos",
      "inherits": "base",
      "displayName": "macos portable Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.4",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "SUPPLE_WERROR": "ON"
      }
    },
    {
      "name": "windows",
      "inherits": "base",
      "displayName": "windows portable Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "SUPPLE_WERROR": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "jobs": 6 },
    { "name": "release", "configurePreset": "release", "jobs": 6 },
    { "name": "gcc", "configurePreset": "gcc", "jobs": 6 },
    { "name": "asan", "configurePreset": "asan", "jobs": 6 },
    { "name": "ubsan", "configurePreset": "ubsan", "jobs": 6 },
    { "name": "tsan", "configurePreset": "tsan", "jobs": 6 },
    { "name": "rtsan", "configurePreset": "rtsan", "jobs": 6 },
    {
      "name": "macos",
      "configurePreset": "macos",
      "jobs": 6
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "jobs": 6
    }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true },
      "execution": { "jobs": 6, "timeout": 600, "noTestsAction": "error" } },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "gcc", "inherits": "base", "configurePreset": "gcc" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan",
      "environment": { "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1" } },
    { "name": "ubsan", "inherits": "base", "configurePreset": "ubsan",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1" },
      "filter": { "exclude": { "label": "slow" } } },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1" },
      "filter": { "exclude": { "label": "tsan-skip|slow" } } },
    { "name": "rtsan", "inherits": "base", "configurePreset": "rtsan",
      "environment": { "RTSAN_OPTIONS": "halt_on_error=1" },
      "filter": { "exclude": { "label": "slow" } } },
    {
      "name": "macos",
      "inherits": "base",
      "configurePreset": "macos"
    },
    {
      "name": "windows",
      "inherits": "base",
      "configurePreset": "windows"
    }
  ],
  "workflowPresets": [
    { "name": "dev", "steps": [
      { "type": "configure", "name": "dev" }, { "type": "build", "name": "dev" }, { "type": "test", "name": "dev" } ] },
    { "name": "release", "steps": [
      { "type": "configure", "name": "release" }, { "type": "build", "name": "release" }, { "type": "test", "name": "release" } ] },
    { "name": "gcc", "steps": [
      { "type": "configure", "name": "gcc" }, { "type": "build", "name": "gcc" }, { "type": "test", "name": "gcc" } ] },
    { "name": "asan", "steps": [
      { "type": "configure", "name": "asan" }, { "type": "build", "name": "asan" }, { "type": "test", "name": "asan" } ] },
    { "name": "ubsan", "steps": [
      { "type": "configure", "name": "ubsan" }, { "type": "build", "name": "ubsan" }, { "type": "test", "name": "ubsan" } ] },
    { "name": "tsan", "steps": [
      { "type": "configure", "name": "tsan" }, { "type": "build", "name": "tsan" }, { "type": "test", "name": "tsan" } ] },
    { "name": "rtsan", "steps": [
      { "type": "configure", "name": "rtsan" }, { "type": "build", "name": "rtsan" }, { "type": "test", "name": "rtsan" } ] },
    {
      "name": "macos",
      "steps": [
        {
          "type": "configure",
          "name": "macos"
        },
        {
          "type": "build",
          "name": "macos"
        },
        {
          "type": "test",
          "name": "macos"
        }
      ]
    },
    {
      "name": "windows",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows"
        },
        {
          "type": "test",
          "name": "windows"
        }
      ]
    }
  ]
}
