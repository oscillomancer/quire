  {
    "name": "compare",
    "title": "Compare two renders or files: notable descriptor changes and timbre distance.",
    "description": "Compare two renders or files: notable descriptor changes and timbre distance. Notable changes use fixed thresholds (loudness 1 LU, centroid 10 %, band levels 1.5 dB, harmonics 3 dB, f0 10 cents, ...). ltas_rms_db is the RMS difference of the 1/3-octave spectra after removing the level offset: a pure gain change reads 0. See describe for errors and examples.",
    "inputSchema": {
      "type": "object",
      "title": "compare_args",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "A render id (rd_1) or an audio file path."
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "description": "A render id (rd_1) or an audio file path."
        }
      },
      "required": ["reference", "test"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "title": "comparison",
      "properties": {
        "notable": {},
        "ltas_rms_db": {
          "type": "number"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["notable", "ltas_rms_db", "summary"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false
    }
  },
  {
    "name": "masking",
    "title": "Estimate where one sound masks another (critical bands).",
    "description": "Estimate where one sound masks another (critical bands). masker (e.g. the kick) and maskee (e.g. the bass): renders or files at the same sample rate. Per Bark band: % of the maskee's active frames masked and by how much; the three worst bands. An estimate for corrective mixing, not a psychoacoustic model of record. See describe for errors and examples.",
    "inputSchema": {
      "type": "object",
      "title": "masking_args",
      "properties": {
        "masker": {
          "type": "string",
          "minLength": 1,
          "description": "A render id (rd_1) or an audio file path."
        },
        "maskee": {
          "type": "string",
          "minLength": 1,
          "description": "A render id (rd_1) or an audio file path."
        }
      },
      "required": ["masker", "maskee"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "title": "masking",
      "properties": {
        "result": {}
      },
      "required": ["result"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false
    }
  },
  {
    "name": "optimize_start",
    "title": "Tune continuous parameters toward a reference sound or a profile (a job).",
    "description": "Tune continuous parameters toward a reference sound or a profile (a job). You choose the structure (patch) and which knobs matter; CMA-ES tunes the numbers. params: \"auto\" (continuous parameters of slots present, max 32) or keys, optionally {key, min, max} to narrow the search. target: {\"reference\": rd_<n> or file} and/or {\"profile\": supple.analysis-profile document}. phrase: notation rendered per candidate (default \"1: C3:w\"; use the reference's phrase when matching a reference). Returns a job: poll job.wait; the result has the best loss per term, changes, a merge patch ({\"params\": {...}}) for patch.merge, and the best candidate's render. See describe for errors and examples.",
    "inputSchema": {
      "type": "object",
      "title": "optimize_args",
      "properties": {
        "instance": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "description": "\"auto\" or a list of keys / {key, min, max}.",
          "default": "auto"
        },
        "target": {
          "description": "{reference?, profile?}"
        },
        "phrase": {
          "type": "string"
        },
        "seconds": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 30.0
        },
        "tail_s": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "evaluations": {
          "type": "integer",
          "minimum": 10.0,
          "maximum": 5000.0
        },
        "max_seconds": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 600.0
        },
        "seed": {
          "type": "integer",
          "minimum": 0.0,
          "maximum": 1e+09,
          "default": 0
        }
      },
      "required": ["instance", "target"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "title": "optimize_started",
      "properties": {
        "job": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "render": {
          "type": "string"
        }
      },
      "required": ["job", "status", "params", "render"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false
    }
  },
  {
    "name": "param_get",
