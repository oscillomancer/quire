  {
    "name": "engine_start",
    "title": "Start real-time playback on the audio device (jack) or without one (dummy).",
    "description": "Start real-time playback on the audio device (jack) or without one (dummy). backend: jack (default; PipeWire's JACK or a JACK server) or dummy (no device, paced like one). block: the engine's block in frames (default 256); the device's period may differ and is reported. The project must run at the device's rate. See describe for errors and examples.",
    "inputSchema": {
      "type": "object",
      "title": "engine_start_args",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["jack", "dummy"]
        },
        "block": {
          "type": "integer",
          "minimum": 16.0,
          "maximum": 4096.0
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "title": "engine_status",
      "properties": {
        "running": {
          "type": "boolean"
        },
        "backend": {
          "type": "string"
        },
        "sample_rate": {
          "type": "number"
        },
        "block": {
          "type": "integer"
        },
        "period": {
          "type": "integer"
        },
        "plan_latency": {
          "type": "integer"
        },
        "device_latency": {
          "type": "integer"
        },
        "xruns": {
          "type": "integer"
        },
        "cycles": {
          "type": "integer"
        },
        "process_errors": {
          "type": "integer"
        },
        "restart_needed": {
          "type": "boolean"
        }
      },
      "required": [
        "running",
        "backend",
        "sample_rate",
        "block",
        "period",
        "plan_latency",
        "device_latency",
        "xruns",
        "cycles",
        "process_errors",
        "restart_needed"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false
    }
