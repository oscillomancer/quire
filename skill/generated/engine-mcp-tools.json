      "type": "object",
      "title": "item_add_args",
      "properties": {
        "track": {
          "type": "string",
          "pattern": "^tr_[0-9]+$",
          "description": "Track id, e.g. \"tr_1\"."
        },
        "position": {
          "type": "number",
          "minimum": 0.0,
          "description": "Beats."
        },
        "bar": {
          "type": "integer",
          "minimum": 1.0,
          "description": "Start at this bar (1-based)."
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "description": "Beats."
        },
        "notation": {
          "type": "string"
        },
        "audio_file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["track"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "title": "item_add",
      "properties": {
        "item": {
          "type": "string"
        },
        "take": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "position": {
          "type": "number"
        },
        "length": {
          "type": "number"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["item", "take", "position", "length"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false
    }
