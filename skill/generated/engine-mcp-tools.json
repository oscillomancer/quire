  {
    "name": "fx_set",
    "title": "Set instance options: bypass, offline, wet (%), label.",
    "description": "Set instance options: bypass, offline, wet (%), label.  See describe for errors and examples.",
    "inputSchema": {
      "type": "object",
      "title": "fx_set_args",
      "properties": {
        "fx": {
          "type": "string",
          "pattern": "^fx_[0-9]+$",
          "description": "Plugin instance id, e.g. \"fx_1\"."
        },
        "bypass": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "wet": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 100.0
            },
            {
              "type": "string",
              "pattern": "^\\s*[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?:\\s*%)?\\s*$"
            }
          ],
          "x-unit": "%",
          "x-unit-strings": true,
          "description": "Quantity strings are range-checked by the server. (%; accepts quantity strings)"
        },
        "label": {
          "type": "string"
        }
      },
      "required": ["fx"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "title": "empty",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
