{
  "id": "synth.strings",
  "limits": {
    "minutes": 8,
    "tool_calls": 60
  },
  "listening": "Does it feel like a cohesive sustained ensemble with a natural swell?",
  "phrase": "notation 1\nmeter 4/4\nvoice v ch 1 vel 96\n1: [C3 E3 G3]:w",
  "prompt": "Program Marram as a wide string ensemble with a gradual bow-like attack and gentle vibrato.",
  "recipe_index": 10,
  "render": {
    "tail_s": 2
  },
  "schema": "supple.eval-task/1.0",
  "score": {
    "profile": {
      "schema": "supple.analysis-profile/1.0",
      "targets": {
        "envelope.attack_ms": {
          "max": 1000,
          "min": 100
        },
        "spectral.centroid_hz.median": {
          "max": 3500,
          "min": 300
        },
        "stereo.width": {
          "max": 0.5,
          "min": 0.03
        }
      }
    },
    "reference": null
  },
  "settings": {
    "block_size": 256,
    "meter": "4/4",
    "sample_rate": 48000,
    "tail_limit_s": 2,
    "tempo": 120
  },
  "setup": [
    {
      "args": {
        "plugin": "com.suppleaudio.marram"
      },
      "command": "plugin.load"
    }
  ],
  "suite": "synth-descriptive"
}
