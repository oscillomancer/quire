{
  "id": "synth.formant-lead",
  "limits": {
    "minutes": 8,
    "tool_calls": 60
  },
  "listening": "Can you hear vowel-like movement without losing the pitched lead?",
  "phrase": "notation 1\nmeter 4/4\nvoice v ch 1 vel 96\n1: C4:w",
  "prompt": "Program Orrery as a vowel-like lead whose timbre moves slowly through a formant wavetable, with light delay.",
  "recipe_index": 9,
  "render": {
    "tail_s": 2
  },
  "schema": "supple.eval-task/1.0",
  "score": {
    "profile": {
      "schema": "supple.analysis-profile/1.0",
      "targets": {
        "envelope.attack_ms": {
          "max": 150,
          "min": 0
        },
        "spectral.centroid_hz.median": {
          "max": 6000,
          "min": 700
        },
        "spectral.flux.median": {
          "max": 0.2,
          "min": 0.001
        }
      }
    },
    "reference": null
  },
  "settings": {
    "block_size": 256,
    "meter": "4/4",
    "sample_rate": 48000,
    "tail_limit_s": 2,
    "tempo": 120
  },
  "setup": [
    {
      "args": {
        "plugin": "com.suppleaudio.orrery"
      },
      "command": "plugin.load"
    }
  ],
  "suite": "synth-descriptive"
}
