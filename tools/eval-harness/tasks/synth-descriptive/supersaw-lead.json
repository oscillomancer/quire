{
  "id": "synth.supersaw-lead",
  "limits": {
    "minutes": 8,
    "tool_calls": 60
  },
  "listening": "Is this a bright, playable lead with a stable wide image?",
  "phrase": "notation 1\nmeter 4/4\nvoice v ch 1 vel 96\n1: C4:w",
  "prompt": "Program Orrery as a bright, wide supersaw lead with seven detuned voices and a quick attack.",
  "recipe_index": 5,
  "render": {
    "tail_s": 2
  },
  "schema": "supple.eval-task/1.0",
  "score": {
    "profile": {
      "schema": "supple.analysis-profile/1.0",
      "targets": {
        "harmonic.voiced_pct": {
          "max": 100,
          "min": 30
        },
        "spectral.centroid_hz.median": {
          "max": 6500,
          "min": 700
        },
        "stereo.width": {
          "max": 0.5,
          "min": 0.03
        }
      }
    },
    "reference": null
  },
  "settings": {
    "block_size": 256,
    "meter": "4/4",
    "sample_rate": 48000,
    "tail_limit_s": 2,
    "tempo": 120
  },
  "setup": [
    {
      "args": {
        "plugin": "com.suppleaudio.orrery"
      },
      "command": "plugin.load"
    }
  ],
  "suite": "synth-descriptive"
}
