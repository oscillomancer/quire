{
  "id": "synth.fm-e-piano",
  "limits": {
    "minutes": 8,
    "tool_calls": 60
  },
  "listening": "Does the attack have FM character while the body stays mellow?",
  "phrase": "notation 1\nmeter 4/4\nvoice v ch 1 vel 96\n1: C4:q r:*",
  "prompt": "Program Orrery as a mellow FM electric piano with a brief brighter attack, velocity sensitivity and chorus.",
  "recipe_index": 7,
  "render": {
    "tail_s": 2
  },
  "schema": "supple.eval-task/1.0",
  "score": {
    "profile": {
      "schema": "supple.analysis-profile/1.0",
      "targets": {
        "envelope.attack_ms": {
          "max": 80,
          "min": 0
        },
        "envelope.decay20_ms": {
          "max": 2200,
          "min": 300
        },
        "spectral.centroid_hz.median": {
          "max": 4000,
          "min": 250
        }
      }
    },
    "reference": null
  },
  "settings": {
    "block_size": 256,
    "meter": "4/4",
    "sample_rate": 48000,
    "tail_limit_s": 2,
    "tempo": 120
  },
  "setup": [
    {
      "args": {
        "plugin": "com.suppleaudio.orrery"
      },
      "command": "plugin.load"
    }
  ],
  "suite": "synth-descriptive"
}
