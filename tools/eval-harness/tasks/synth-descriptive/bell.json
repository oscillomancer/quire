{
  "id": "synth.bell",
  "limits": {
    "minutes": 8,
    "tool_calls": 60
  },
  "listening": "Does the strike sound metallic, with a smooth ringing decay?",
  "phrase": "notation 1\nmeter 4/4\nvoice v ch 1 vel 96\n1: C4:q r:*",
  "prompt": "Program Orrery as a metallic bell with inharmonic partials, a fast strike and a long decay.",
  "recipe_index": 6,
  "render": {
    "tail_s": 2
  },
  "schema": "supple.eval-task/1.0",
  "score": {
    "profile": {
      "schema": "supple.analysis-profile/1.0",
      "targets": {
        "envelope.attack_ms": {
          "max": 50,
          "min": 0
        },
        "envelope.decay20_ms": {
          "max": 3500,
          "min": 400
        },
        "spectral.centroid_hz.median": {
          "max": 5000,
          "min": 400
        }
      }
    },
    "reference": null
  },
  "settings": {
    "block_size": 256,
    "meter": "4/4",
    "sample_rate": 48000,
    "tail_limit_s": 2,
    "tempo": 120
  },
  "setup": [
    {
      "args": {
        "plugin": "com.suppleaudio.orrery"
      },
      "command": "plugin.load"
    }
  ],
  "suite": "synth-descriptive"
}
