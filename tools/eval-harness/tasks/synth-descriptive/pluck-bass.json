{
  "id": "synth.pluck-bass",
  "limits": {
    "minutes": 8,
    "tool_calls": 60
  },
  "listening": "Is the filter snap short and audible, with convincing bass weight?",
  "phrase": "notation 1\nmeter 4/4\nvoice v ch 1 vel 96\n1: C2:q r:*",
  "prompt": "Program Orrery as a plucky bass with a short resonant filter snap and a solid low end.",
  "recipe_index": 2,
  "render": {
    "tail_s": 2
  },
  "schema": "supple.eval-task/1.0",
  "score": {
    "profile": {
      "schema": "supple.analysis-profile/1.0",
      "targets": {
        "envelope.attack_ms": {
          "max": 60,
          "min": 0
        },
        "envelope.decay20_ms": {
          "max": 1600,
          "min": 150
        },
        "spectral.centroid_hz.median": {
          "max": 1200,
          "min": 100
        }
      }
    },
    "reference": null
  },
  "settings": {
    "block_size": 256,
    "meter": "4/4",
    "sample_rate": 48000,
    "tail_limit_s": 2,
    "tempo": 120
  },
  "setup": [
    {
      "args": {
        "plugin": "com.suppleaudio.orrery"
      },
      "command": "plugin.load"
    }
  ],
  "suite": "synth-descriptive"
}
