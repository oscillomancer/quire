#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
slug='@PRODUCT_SLUG@'
prefix="${HOME}/.local"
plugins=0
while (($#)); do
  case "$1" in
    --prefix) prefix=${2:?--prefix needs a directory}; shift 2 ;;
    --plugins) plugins=1; shift ;;
    *) echo "Usage: $0 [--prefix DIR] [--plugins]" >&2; exit 2 ;;
  esac
done
source_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
[[ $prefix = /* && $prefix != *$'\n'* ]] || { echo 'Use an absolute prefix without newlines' >&2; exit 1; }
prefix=$(realpath -m -- "$prefix")
[[ $prefix != / ]] || { echo 'Choose a user-space installation prefix, not /' >&2; exit 1; }
app="$prefix/opt/$slug"
[[ $source_dir != "$app" ]] || { echo 'Run install.sh from the new extracted download, outside the installed app folder.' >&2; exit 1; }
declare -A previous_files=() previous_dirs=()
if [[ -f "$app/.installed-files" && -f "$app/uninstall.sh" && ! -L $app ]]; then
  # Preserve the previous opt-in and ownership until all preflight checks pass.
  while IFS= read -r file; do
    previous_files["$file"]=1
    case "$file" in "$HOME/.clap/"*) plugins=1 ;; esac
  done < "$app/.installed-files"
  if [[ -f "$app/.installed-dirs" ]]; then
    while IFS= read -r dir; do previous_dirs["$dir"]=1; done < "$app/.installed-dirs"
  fi
  upgrade=1
else
  upgrade=0
fi
if ((!upgrade)) && [[ -e $app || -L $app ]]; then
  echo "Refusing foreign installation folder: $app" >&2; exit 1
fi
# Existing owned files will be removed by the old uninstaller. Shared real
# directories may remain; foreign files and directory symlinks may not collide.
check_destination() {
  local dest=$1 kind=$2
  if [[ ! -e $dest && ! -L $dest ]]; then return; fi
  if [[ $kind = directory && -d $dest && ! -L $dest ]]; then return; fi
  if [[ ${previous_files["$dest"]:-0} = 1 && (! -d $dest || -L $dest) ]]; then return; fi
  # An old owned directory is free only if uninstall can actually remove it.
  if [[ $kind = file && -d $dest && ! -L $dest && ${previous_dirs["$dest"]:-0} = 1 ]]; then
    local entry
    while IFS= read -r -d '' entry; do
      [[ ${previous_files["$entry"]:-0} = 1 || ${previous_dirs["$entry"]:-0} = 1 ]] || {
        echo "Already exists: $entry" >&2; return 1;
      }
    done < <(find "$dest" -mindepth 1 -print0)
    return
  fi
  echo "Already exists: $dest" >&2; return 1
}
# Check every destination directory too, so a foreign ancestor cannot cause a
# copy failure after the old installation has been removed.
for dir in "$prefix/opt" "$prefix/bin" "$prefix/share" "$prefix/share/applications"; do
  check_destination "$dir" directory
done
while IFS= read -r -d '' dir; do
  rel=${dir#"$source_dir"}
  check_destination "$app$rel" directory
done < <(find "$source_dir" -type d -print0)
while IFS= read -r -d '' file; do
  rel=${file#"$source_dir/"}
  check_destination "$app/$rel" file
done < <(find "$source_dir" \( -type f -o -type l \) -print0)
# Refuse collisions before copying anything; never replace another host's CLAP.
for exe in "$source_dir"/bin/*; do
  dest="$prefix/bin/${exe##*/}"
  check_destination "$dest" file
done
check_destination "$prefix/share/applications/$slug.desktop" file
while IFS= read -r -d '' dir; do
  check_destination "$prefix/${dir#"$source_dir/"}" directory
done < <(find "$source_dir/share/icons" -type d -print0 2>/dev/null || true)
while IFS= read -r -d '' file; do
  check_destination "$prefix/${file#"$source_dir/"}" file
done < <(find "$source_dir/share/icons" -type f -print0 2>/dev/null || true)
if ((plugins)); then
  check_destination "$HOME/.clap" directory
  for file in "$source_dir/lib/$slug/plugins/"*; do
    check_destination "$HOME/.clap/${file##*/}" file
  done
fi
if ((upgrade)); then "$app/uninstall.sh" --prefix "$prefix"; fi
mkdir -p "$prefix/opt" "$prefix/bin"
mkdir -p "$app"
cp -a "$source_dir/." "$app/"
manifest="$app/.installed-files"
find "$source_dir" -type d -printf '%P\n' | while IFS= read -r rel; do printf '%s\n' "$app${rel:+/$rel}"; done > "$app/.installed-dirs"
find "$source_dir" \( -type f -o -type l \) -printf '%P\n' | while IFS= read -r rel; do printf '%s\n' "$app/$rel"; done > "$manifest"
# Roll back partial installs on failure using the same ownership manifest.
trap '"$app/uninstall.sh" --prefix "$prefix"' ERR
for exe in "$app"/bin/*; do
  dest="$prefix/bin/${exe##*/}"
  ln -s "$exe" "$dest"
  printf '%s\n' "$dest" >> "$manifest"
done
mkdir -p "$prefix/share/applications"
desktop="$prefix/share/applications/$slug.desktop"
# Desktop Exec quoting is distinct from shell quoting.
escaped=${app//\\/\\\\}; escaped=${escaped//\"/\\\"}; escaped=${escaped//\$/\\\$}; escaped=${escaped//\`/\\\`}; escaped=${escaped//%/%%}
escaped=${escaped//\\/\\\\}
while IFS= read -r line; do
  case "$line" in
    Exec=*) printf 'Exec="%s/bin/%s" %%f\n' "$escaped" "$slug" ;;
    *) printf '%s\n' "$line" ;;
  esac
done < "$app/share/applications/$slug.desktop" > "$desktop"
printf '%s\n' "$desktop" >> "$manifest"
while IFS= read -r -d '' file; do
  rel=${file#"$app/"}; dest="$prefix/$rel"
  mkdir -p "${dest%/*}"; cp -a "$file" "$dest"; printf '%s\n' "$dest" >> "$manifest"
done < <(find "$app/share/icons" -type f -print0 2>/dev/null || true)
if ((plugins)); then
  mkdir -p "$HOME/.clap"
  for file in "$app/lib/$slug/plugins/"*; do
    dest="$HOME/.clap/${file##*/}"
    cp -a "$file" "$dest"; printf '%s\n' "$dest" >> "$manifest"
  done
fi
desktop_cache="$prefix/share/applications/mimeinfo.cache"
icon_cache="$prefix/share/icons/hicolor/icon-theme.cache"
[[ -e "$desktop_cache" ]] && had_desktop_cache=1 || had_desktop_cache=0
[[ -e "$icon_cache" ]] && had_icon_cache=1 || had_icon_cache=0
command -v update-desktop-database >/dev/null && update-desktop-database "$prefix/share/applications" || true
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$prefix/share/icons/hicolor" >/dev/null 2>&1 || true
if ((!had_desktop_cache)) && [[ -f "$desktop_cache" ]]; then printf '%s\n' "$desktop_cache" >> "$manifest"; fi
if ((!had_icon_cache)) && [[ -f "$icon_cache" ]]; then printf '%s\n' "$icon_cache" >> "$manifest"; fi
trap - ERR
printf 'Installed %s in %s\nMCP command: %s/bin/%s-mcp\n' '@PRODUCT_NAME@' "$app" "$prefix" "$slug"
