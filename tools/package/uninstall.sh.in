#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
slug='@PRODUCT_SLUG@'
prefix="${HOME}/.local"
if (($#)); then
  [[ $# = 2 && $1 = --prefix ]] || { echo "Usage: $0 [--prefix DIR]" >&2; exit 2; }
  prefix=$2
fi
app="$prefix/opt/$slug"
[[ -f "$app/.installed-files" ]] || { echo "No installation manifest in $app" >&2; exit 1; }
# Only paths explicitly added by install.sh; existing unrelated files survive.
while IFS= read -r file; do
  case "$file" in
    "$prefix/bin/"*|"$prefix/share/applications/$slug.desktop"|"$prefix/share/applications/mimeinfo.cache"|"$prefix/share/icons/"*|"$HOME/.clap/"*) rm -f -- "$file" ;;
    *) echo "Invalid manifest path: $file" >&2; exit 1 ;;
  esac
done < "$app/.installed-files"
rm -rf -- "$app"
# Prune empty integration directories, stopping at the chosen prefix.
if [[ -d "$prefix/share/icons" ]]; then
  find "$prefix/share/icons" -depth -type d -empty -delete
fi
for dir in "$prefix/share/applications" "$prefix/share" "$prefix/bin" "$prefix/opt" "$prefix"; do
  rmdir -- "$dir" 2>/dev/null || true
done
command -v update-desktop-database >/dev/null && [[ -d "$prefix/share/applications" ]] && update-desktop-database "$prefix/share/applications" || true
command -v gtk-update-icon-cache >/dev/null && [[ -d "$prefix/share/icons/hicolor" ]] && gtk-update-icon-cache -f -t "$prefix/share/icons/hicolor" >/dev/null 2>&1 || true
printf 'Uninstalled %s\n' '@PRODUCT_NAME@'
