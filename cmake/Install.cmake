# Installed layouts are paired with host::stockPluginDir()/skillDir().
if(NOT TARGET ${PRODUCT_SLUG})
  return()
endif()
set(package_dir "${CMAKE_BINARY_DIR}/package")
file(MAKE_DIRECTORY "${package_dir}")
if(APPLE)
  set(app "${PRODUCT_NAME}.app/Contents")
  set(exe_dest "${app}/MacOS")
  set(lib_dest "${app}/Frameworks")
  set(data_dest "${app}/Resources")
  set(plugin_dest "${app}/PlugIns/CLAP")
  set(doc_dest "${data_dest}/licenses")
elseif(WIN32)
  set(exe_dest ".")
  set(lib_dest ".")
  set(data_dest ".")
  set(plugin_dest "plugins/clap")
  set(doc_dest "licenses")
else()
  set(exe_dest "bin")
  set(lib_dest "lib/${PRODUCT_SLUG}")
  set(data_dest "share/${PRODUCT_SLUG}")
  set(plugin_dest "${lib_dest}/plugins")
  set(doc_dest "share/doc/${PRODUCT_SLUG}")
endif()
foreach(suffix "" -engine -mcp -bridge -scanner)
  set(target "${PRODUCT_SLUG}${suffix}")
  if(APPLE)
    set_target_properties(${target} PROPERTIES INSTALL_RPATH "@executable_path/../Frameworks")
  elseif(UNIX)
    set_target_properties(${target} PROPERTIES INSTALL_RPATH "$ORIGIN/../lib/${PRODUCT_SLUG}")
    # DT_RPATH also applies to private dependencies of dlopened plugins.
    target_link_options(${target} PRIVATE "LINKER:--disable-new-dtags")
  endif()
  if(APPLE AND suffix STREQUAL "")
    install(TARGETS ${target} BUNDLE DESTINATION . COMPONENT Runtime)
    if(NOT PRODUCT_NAME STREQUAL PRODUCT_SLUG)
      install(CODE "file(RENAME \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${PRODUCT_SLUG}.app\" \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${PRODUCT_NAME}.app\")" COMPONENT Runtime)
    endif()
  else()
    install(TARGETS ${target} RUNTIME DESTINATION "${exe_dest}" COMPONENT Runtime)
  endif()
endforeach()
# Imported target files preserve the actual runtime filename and its SONAME.
if(TARGET SDL3::SDL3-shared)
  install(IMPORTED_RUNTIME_ARTIFACTS SDL3::SDL3-shared
    LIBRARY DESTINATION "${lib_dest}" COMPONENT Runtime
    RUNTIME DESTINATION "${lib_dest}" COMPONENT Runtime
    FRAMEWORK DESTINATION "${lib_dest}" COMPONENT Runtime)
endif()
if(WIN32)
  # vcpkg app-local deployment places zlib/SDL and the dynamic CRT beside the GUI.
  install(CODE "file(GLOB runtime_dlls \"$<TARGET_FILE_DIR:${PRODUCT_SLUG}>/*.dll\")
    file(INSTALL DESTINATION \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}\" TYPE FILE FILES \${runtime_dlls})" COMPONENT Runtime)
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION ".")
  set(CMAKE_INSTALL_SYSTEM_RUNTIME_COMPONENT Runtime)
  include(InstallRequiredSystemLibraries)
endif()
install(DIRECTORY "${PROJECT_SOURCE_DIR}/skill/" DESTINATION "${data_dest}/skill" COMPONENT Runtime)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/assets/fonts/" DESTINATION "${data_dest}/fonts" COMPONENT Runtime)
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/THIRD_PARTY.md"
  DESTINATION "${doc_dest}" COMPONENT Runtime)
# Ship all vendored notices (a conservative superset of linked components).
file(READ "${PROJECT_SOURCE_DIR}/third_party/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" dependencies)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON name GET "${manifest}" dependencies ${i} name)
  string(JSON license ERROR_VARIABLE missing GET "${manifest}" dependencies ${i} license_file)
  if(missing)
    continue() # Fetched macOS renderer notices already travel inside each plugin.
  endif()
  install(FILES "${PROJECT_SOURCE_DIR}/third_party/${license}"
    DESTINATION "${doc_dest}/third-party/${name}" COMPONENT Runtime)
endforeach()
if(SUPPLE_BUILD_PLUGINS)
  # The player is a development tool, not one of the fourteen stock products.
  get_property(products GLOBAL PROPERTY SUPPLE_STAGED_PLUGINS)
  list(REMOVE_ITEM products "Script Player")
  foreach(product IN LISTS products)
    if(APPLE)
      install(DIRECTORY "${CMAKE_BINARY_DIR}/plugins/clap/${product}.clap"
        DESTINATION "${plugin_dest}" USE_SOURCE_PERMISSIONS COMPONENT Plugins)
    else()
      install(FILES "${CMAKE_BINARY_DIR}/plugins/clap/${product}.clap"
        DESTINATION "${plugin_dest}" COMPONENT Plugins)
    endif()
    if(NOT APPLE)
      # macOS bundles already carry notices in Contents/Resources. Loose text
      # in PlugIns is treated as nested code by Apple's signing machinery.
      install(FILES "${CMAKE_BINARY_DIR}/plugins/clap/${product}-LICENSE.txt"
        "${CMAKE_BINARY_DIR}/plugins/clap/${product}-NOTICES.txt"
        DESTINATION "${plugin_dest}" COMPONENT Plugins)
    endif()
  endforeach()
endif()
if(APPLE)
  if(EXISTS "${PROJECT_SOURCE_DIR}/assets/icon/app.icns")
    install(FILES "${PROJECT_SOURCE_DIR}/assets/icon/app.icns" DESTINATION "${data_dest}" COMPONENT Runtime)
  endif()
elseif(NOT WIN32)
  configure_file("${PROJECT_SOURCE_DIR}/cmake/package/app.desktop.in" "${package_dir}/${PRODUCT_SLUG}.desktop" @ONLY)
  install(FILES "${package_dir}/${PRODUCT_SLUG}.desktop" DESTINATION share/applications COMPONENT Runtime)
  foreach(size 16 24 32 48 64 128 256 512 1024)
    if(EXISTS "${PROJECT_SOURCE_DIR}/assets/icon/png/app-${size}.png")
      install(FILES "${PROJECT_SOURCE_DIR}/assets/icon/png/app-${size}.png"
        DESTINATION "share/icons/hicolor/${size}x${size}/apps" RENAME "${PRODUCT_SLUG}.png" COMPONENT Runtime)
    endif()
  endforeach()
  foreach(script install uninstall)
    configure_file("${PROJECT_SOURCE_DIR}/tools/package/${script}.sh.in" "${package_dir}/${script}.sh" @ONLY)
    install(PROGRAMS "${package_dir}/${script}.sh" DESTINATION . COMPONENT Runtime)
  endforeach()
endif()
# A machine-readable handoff avoids duplicating identity in packaging scripts.
file(WRITE "${package_dir}/product.json"
  "{\"name\":\"${PRODUCT_NAME}\",\"slug\":\"${PRODUCT_SLUG}\",\"vendor\":\"${PRODUCT_VENDOR}\",\"version\":\"${PRODUCT_VERSION}\",\"vendor_id\":\"${PRODUCT_VENDOR_ID}\"}\n")
set(package_targets ${PRODUCT_SLUG} ${PRODUCT_SLUG}-engine ${PRODUCT_SLUG}-mcp
                    ${PRODUCT_SLUG}-bridge ${PRODUCT_SLUG}-scanner skill-tree)
if(SUPPLE_BUILD_PLUGINS)
  foreach(product IN LISTS products)
    string(TOLOWER "${product}" name)
    list(APPEND package_targets plugin-${name})
  endforeach()
endif()
add_custom_target(package-runtime DEPENDS ${package_targets})

if(SUPPLE_BUILD_TESTS AND Python3_FOUND AND SUPPLE_PLATFORM_LINUX)
  add_test(NAME package.tests COMMAND ${Python3_EXECUTABLE} -m unittest discover
    -s ${PROJECT_SOURCE_DIR}/tools/package)
endif()
