# The single place the product's name and identity are defined.
# Renaming the product = editing this file (plus the repository directory).
# Code gets these values from the generated header <supple/product.h>.
set(PRODUCT_NAME "Quire")               # display name
set(PRODUCT_SLUG "quire")               # lowercase: binary prefix, dirs, socket names
set(PRODUCT_VENDOR "Supple Audio")
set(PRODUCT_VENDOR_ID "com.suppleaudio") # reverse-DNS prefix for plugin/extension IDs
set(PRODUCT_VERSION "0.2.0")
