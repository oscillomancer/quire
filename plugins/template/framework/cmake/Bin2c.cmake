# Turn a binary file into a C translation unit holding it as a byte array.
#
# Used for the embedded fonts: NanoVG wants a TTF in memory, and a plugin has
# nowhere reliable to load one from at runtime -- the bundle layout differs per
# format and per host, and a missing file would mean a GUI with no text. The
# .ttf files in framework/gui/fonts are the source of truth; this generates the
# array at build time so nothing generated is committed.
#
# Usage:
#   cmake -DINPUT=<file> -DOUTPUT=<file.c> -DSYMBOL=<identifier> -P Bin2c.cmake

if (NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "bin2c: INPUT, OUTPUT and SYMBOL are all required")
endif()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hexLen)
math(EXPR byteCount "${hexLen} / 2")

# One regex pass rather than a per-byte loop: the loop form takes seconds on a
# font-sized input, this takes milliseconds.
string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
# Wrap at 16 bytes per line so the generated file stays diffable and no
# compiler hits a line-length limit.
string(REPEAT "[^,]+," 16 line_pattern)
string(REGEX REPLACE "(${line_pattern})" "\\1\n" bytes "${bytes}")

get_filename_component(inputName "${INPUT}" NAME)

file(WRITE "${OUTPUT}"
"// Generated by framework/cmake/Bin2c.cmake from ${inputName}. Do not edit.\n"
"#include <stddef.h>\n\n"
"const unsigned char ${SYMBOL}[] = {\n${bytes}\n};\n"
"const size_t ${SYMBOL}_size = ${byteCount};\n")
