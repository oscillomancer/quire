cmake_minimum_required(VERSION 3.27)
file(MAKE_DIRECTORY "${WORK}")
foreach(size 0 1 15 16 17 32 257)
    string(REPEAT "a" ${size} input)
    file(WRITE "${WORK}/input" "${input}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${WORK}/input" "-DOUTPUT=${WORK}/output.c" -DSYMBOL=test_bytes
        -P "${FRAMEWORK}/cmake/Bin2c.cmake" COMMAND_ERROR_IS_FATAL ANY)
    file(STRINGS "${WORK}/output.c" lines)
    set(count 0)
    foreach(line IN LISTS lines)
        if (line MATCHES "^0x")
            string(REGEX MATCHALL "0x61," bytes "${line}")
            list(LENGTH bytes length)
            if (length GREATER 16)
                message(FATAL_ERROR "bin2c wrote ${length} bytes on one line")
            endif()
            math(EXPR count "${count} + ${length}")
        endif()
    endforeach()
    if (NOT count EQUAL size)
        message(FATAL_ERROR "bin2c lost bytes: ${count} instead of ${size}")
    endif()
endforeach()
