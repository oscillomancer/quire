cmake_minimum_required(VERSION 3.27)
include("${FRAMEWORK}/cmake/PatchedSource.cmake")
find_package(Git REQUIRED)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/source")
set(source "${WORK}/source")
set(copy "${WORK}/copy")
function(check value)
    file(WRITE "${source}/file" "${value}")
    supple_copy_for_patch("${source}" "${copy}" "")
    file(READ "${copy}/file" actual)
    if (NOT actual STREQUAL value)
        message(FATAL_ERROR "stale patched source: ${actual}, expected ${value}")
    endif()
endfunction()
check("plain one")
check("plain two")
execute_process(COMMAND "${GIT_EXECUTABLE}" init -q "${source}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" add file COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" -c user.name=Test -c user.email=test@example.invalid commit -qm initial COMMAND_ERROR_IS_FATAL ANY)
check("plain two")  # now a clean checkout
check("dirty one")
check("dirty two")  # identical porcelain status, different contents
file(WRITE "${source}/new" "untracked")
supple_copy_for_patch("${source}" "${copy}" "")
if (NOT EXISTS "${copy}/new")
    message(FATAL_ERROR "untracked source was not copied")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" add . COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" -c user.name=Test -c user.email=test@example.invalid commit -qm changed COMMAND_ERROR_IS_FATAL ANY)
check("dirty two")  # a new clean revision
file(WRITE "${copy}/marker" "preserve an unchanged patched copy")
supple_copy_for_patch("${source}" "${copy}" "")
if (NOT EXISTS "${copy}/marker")
    message(FATAL_ERROR "unchanged checkout was copied again")
endif()
