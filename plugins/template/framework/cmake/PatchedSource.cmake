# Keep a build-owned copy in step with its unpatched source. Vendored trees
# are immutable and identified by their pin; source overrides may be edited.
function(supple_copy_for_patch source copy patches)
    set(immutable "${ARGV3}")
    set(stamp "${source}")
    set(recopy FALSE)
    if (immutable AND EXISTS "${source}/.supple-pin")
        file(READ "${source}/.supple-pin" pin)
        string(APPEND stamp " ${pin}")
    elseif (EXISTS "${source}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
            OUTPUT_VARIABLE revision COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" status --porcelain --untracked-files=all
            OUTPUT_VARIABLE status COMMAND_ERROR_IS_FATAL ANY)
        string(SHA256 status_hash "${status}")
        string(APPEND stamp " ${revision} ${status_hash}")
        if (NOT status STREQUAL "")
            # Porcelain alone does not change on a second edit to a dirty
            # file. Include contents, including untracked files, as well.
            file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
            list(SORT files)
            foreach(file IN LISTS files)
                if (file MATCHES "^\\.git(/|$)")
                    continue()
                endif()
                file(SHA256 "${source}/${file}" hash)
                string(APPEND stamp " ${file}:${hash}")
            endforeach()
        endif()
    else()
        set(recopy TRUE)
    endif()
    foreach(patch IN LISTS patches)
        file(SHA256 "${SUPPLE_FRAMEWORK}/cmake/patches/${patch}" hash)
        string(APPEND stamp " ${patch}:${hash}")
    endforeach()
    string(SHA256 stamp "${stamp}")
    set(had "")
    if (EXISTS "${copy}/.supple-copy")
        file(READ "${copy}/.supple-copy" had)
    endif()
    if (recopy OR NOT had STREQUAL stamp)
        message(STATUS "Copying ${source} to patch it")
        file(REMOVE_RECURSE "${copy}")
        file(COPY "${source}/" DESTINATION "${copy}" PATTERN ".git" EXCLUDE)
        execute_process(COMMAND "${GIT_EXECUTABLE}" init -q WORKING_DIRECTORY "${copy}" COMMAND_ERROR_IS_FATAL ANY)
        file(WRITE "${copy}/.supple-copy" "${stamp}")
    endif()
endfunction()
