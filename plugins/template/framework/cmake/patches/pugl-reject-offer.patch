+PuglStatus
+puglRejectOffer(PuglView* const                 view,
+                const PuglDataOfferEvent* const offer,
+                const int                       PUGL_UNUSED(regionX),
+                const int                       PUGL_UNUSED(regionY),
+                const unsigned                  PUGL_UNUSED(regionWidth),
+                const unsigned                  PUGL_UNUSED(regionHeight))
+{
+  // Forget an earlier acceptance in this drag, so leaving a target ends it.
+  if (offer->clipboard == PUGL_CLIPBOARD_DRAG) {
+    PuglWrapperView* const wrapper = view->impl->wrapperView;
+    wrapper->dragOperation         = NSDragOperationNone;
+    wrapper->acceptedDragTypeIndex = UINT32_MAX;
+  }
+
+  return PUGL_SUCCESS;
+}
