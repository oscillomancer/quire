+// Main thread, from onIdle: what a host does for CLAP's request_restart.
+// Same buses, sample rate and block sizes; the plugin prepares again, so a
+// change that needed a restart (latency, oversampling) takes effect. The
+// plugin reports a new latency from activate(), which reaches the host as
+// kAudioUnitProperty_Latency.
+void WrapAsAUV2::restartCLAP()
+{
+  if (!_plugin || !_initialized) return;
+  auto guarantee_mainthread = _plugin->AlwaysMainThread();
+  ClapWrapper::detail::shared::SpinLockGuard guard(_renderLock);
+  _plugin->stop_processing();
+  _plugin->deactivate();
+  if (!_plugin->activate())
+  {
+    // As if uninitialized: Render does nothing until the host initializes again.
+    _initialized = false;
+    return;
+  }
+  _plugin->start_processing();
+}
