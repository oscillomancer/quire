+void WrapAsAUV2::noteBypassValue(clap_id id, double value)
+{
+  if (id == CLAP_INVALID_ID || id != _bypassParamID) return;
+  const bool bypassed = value >= _bypassThreshold.load(std::memory_order_relaxed);
+  if (_isBypassed.exchange(bypassed) != bypassed) _bypassChanged = true;
+}
