--- a/src/detail/vst3/process.cpp
+++ b/src/detail/vst3/process.cpp
@@ -814,6 +814,44 @@
       break;
 
     case CLAP_EVENT_MIDI:
+    {
+      // Controllers, pitch bend, pressure and program changes leave as VST3's
+      // legacy MIDI CC output events; notes arrive as CLAP note events.
+      auto mevt = reinterpret_cast<const clap_event_midi *>(event);
+      Steinberg::Vst::Event oe{};
+      oe.type = Steinberg::Vst::Event::kLegacyMIDICCOutEvent;
+      oe.busIndex = 0;
+      oe.sampleOffset = mevt->header.time;
+      oe.midiCCOut.channel = static_cast<Steinberg::int8>(mevt->data[0] & 0x0F);
+      oe.midiCCOut.value = static_cast<Steinberg::int8>(mevt->data[1] & 0x7F);
+      oe.midiCCOut.value2 = static_cast<Steinberg::int8>(mevt->data[2] & 0x7F);
+      switch (mevt->data[0] & 0xF0)
+      {
+        case 0xB0:
+          oe.midiCCOut.controlNumber = mevt->data[1] & 0x7F;
+          oe.midiCCOut.value = static_cast<Steinberg::int8>(mevt->data[2] & 0x7F);
+          oe.midiCCOut.value2 = 0;
+          break;
+        case 0xE0:
+          oe.midiCCOut.controlNumber = Vst::ControllerNumbers::kPitchBend;
+          break;
+        case 0xD0:
+          oe.midiCCOut.controlNumber = Vst::ControllerNumbers::kAfterTouch;
+          oe.midiCCOut.value2 = 0;
+          break;
+        case 0xC0:
+          oe.midiCCOut.controlNumber = Vst::ControllerNumbers::kCtrlProgramChange;
+          oe.midiCCOut.value2 = 0;
+          break;
+        case 0xA0:
+          oe.midiCCOut.controlNumber = Vst::ControllerNumbers::kCtrlPolyPressure;
+          break;
+        default:
+          return true;
+      }
+      if (_vstdata && _vstdata->outputEvents) _vstdata->outputEvents->addEvent(oe);
+    }
+      return true;
     case CLAP_EVENT_MIDI_SYSEX:
     case CLAP_EVENT_MIDI2:
       return true;
