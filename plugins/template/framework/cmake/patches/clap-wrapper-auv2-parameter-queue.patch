@@ -189,6 +189,19 @@ void ProcessAdapter::sortEventIndices()
 
 void ProcessAdapter::process(ProcessData &data)
 {
+  // The host's parameter changes since the last cycle. A setter holds the
+  // lock only to copy one event in; if one has it now, they wait a cycle.
+  if (_pendingLock.try_lock())
+  {
+    for (size_t i = 0; i < _pendingCount && _events.size() < _events.capacity(); ++i)
+    {
+      _eventindices.emplace_back(_events.size());
+      _events.emplace_back(_pending[i]);
+    }
+    _pendingCount = 0;
+    _pendingLock.unlock();
+  }
+
   // CLAP requires event times within [0, frames_count); a host stamping
   // MIDIEventList packets with out-of-range timestamps (e.g. mach host time
   // instead of sample offsets) would otherwise make plugins that index their
@@ -802,7 +815,19 @@ void ProcessAdapter::addParameterEvent(const clap_param_info_t &info, double val
   n.param.channel = -1;
   n.param.note_id = -1;
 
-  this->_eventindices.emplace_back(this->_events.size());
-  this->_events.emplace_back(n);
+  ClapWrapper::detail::shared::SpinLockGuard guard(_pendingLock);
+  if (_pendingCount < _pending.size())
+  {
+    _pending[_pendingCount++] = n;
+    return;
+  }
+  for (size_t i = _pendingCount; i-- > 0;)
+  {
+    if (_pending[i].param.param_id == n.param.param_id)
+    {
+      _pending[i] = n;
+      return;
+    }
+  }
 }
